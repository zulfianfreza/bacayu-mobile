<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_calm_a" android:padding="14dp">
    <ImageView android:id="@+id/streak_widget_mascot" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="bottom|center_horizontal" android:scaleType="fitCenter" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_streak_flame" />
            <TextView android:id="@+id/streak_widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/streak_widget_ink" android:textSize="26sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/streak_widget_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/streak_widget_ink" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
